  <property name="windowTitle"><string>EduVoice — Offline AI Assistant</string></property  <property name="styleSheet"><string notr="true">QMainWindow, QWidget#centralwidget, QWidget#content { background: #0B0F17; }
QFrame#sidebar { background: rgba(15, 23, 42, 0.75); border-right: 1px solid rgba(255, 255, 255, 0.08); }
QLabel { color: #F8FAFC; font-family: &quot;Segoe UI&quot;, sans-serif; }
QLabel#brandName { color: #FFFFFF; font-size: 20px; font-weight: 700; }
QLabel#brandCaption { color: #64748B; font-size: 10px; font-weight: 600; letter-spacing: 1px; }
QLabel#pageTitle { color: #F8FAFC; font-size: 28px; font-weight: 700; }
QLabel#pageSubtitle { color: #94A3B8; font-size: 13px; }
QLabel#sectionTitle { color: #F8FAFC; font-size: 17px; font-weight: 700; }
QLabel#cardLabel { color: #94A3B8; font-size: 12px; font-weight: 600; }
QLabel#cardValue { color: #FFFFFF; font-size: 29px; font-weight: 700; }
QLabel#cardMeta { color: #34D399; font-size: 11px; font-weight: 600; }
QLabel#activityTitle { color: #F8FAFC; font-size: 13px; font-weight: 600; }
QLabel#activityTime { color: #94A3B8; font-size: 11px; }
QLabel#profileName { color: white; font-size: 12px; font-weight: 700; }
QLabel#profileRole { color: #94A3B8; font-size: 10px; }
QFrame#card, QFrame#activityPanel { background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; }
QFrame#quickPanel { background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; }
QFrame#iconBubble { background: rgba(37, 99, 235, 0.2); border: 1px solid rgba(37, 99, 235, 0.3); border-radius: 12px; }
QFrame#greenBubble { background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; }
QFrame#orangeBubble { background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 12px; }
QFrame#purpleBubble { background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; }
QPushButton#navButton { background: transparent; color: #94A3B8; border: none; border-radius: 8px; text-align: left; padding: 10px 14px; font-family: &quot;Segoe UI&quot;; font-size: 13px; font-weight: 600; }
QPushButton#navButton:hover { background: rgba(255, 255, 255, 0.05); color: #F8FAFC; }
QPushButton#navButton:checked { background: rgba(37, 99, 235, 0.8); color: #FFFFFF; font-weight: 700; }
QPushButton#listenButton { background: rgba(37, 99, 235, 0.85); color: white; border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 18px; padding: 10px 20px; font-family: &quot;Segoe UI&quot;; font-size: 14px; font-weight: 700; }
QPushButton#listenButton:hover { background: rgba(59, 130, 246, 0.95); border-color: rgba(147, 197, 253, 0.6); }
QPushButton#topButton { background: rgba(30, 41, 59, 0.6); color: #94A3B8; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px; font-size: 15px; }
QPushButton#topButton:hover { background: rgba(51, 65, 85, 0.8); color: white; }
QStatusBar { background: rgba(15, 23, 42, 0.9); color: #94A3B8; border-top: 1px solid rgba(255, 255, 255, 0.08); font-family: &quot;Segoe UI&quot;; font-size: 11px; }
</string></property>
